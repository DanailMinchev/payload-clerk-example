{
  "name": "payload-clerk-example",
  "version": "0.0.0-development",
  "private": true,
  "description": "Payload CMS and Clerk example",
  "license": "MIT",
  "author": "Danail Minchev <danail.minchev@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest",
    "test:e2e": "npm run playwright:test",
    "playwright:test": "dotenvx run -f .env.local --ignore=MISSING_ENV_FILE -- playwright test",
    "playwright:test:debug": "dotenvx run -f .env.local --ignore=MISSING_ENV_FILE -- playwright test --debug",
    "playwright:test:ui": "dotenvx run -f .env.local --ignore=MISSING_ENV_FILE -- playwright test --ui",
    "format": "prettier . --write",
    "format:ci": "prettier . --check",
    "payload": "dotenvx run --convention=nextjs --ignore=MISSING_ENV_FILE -- cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload",
    "payload:migrate": "npm run payload -- migrate",
    "payload:migrate:create": "npm run payload -- migrate:create",
    "payload:migrate:status": "npm run payload -- migrate:status",
    "payload:migrate:down": "npm run payload -- migrate:down",
    "payload:migrate:fresh": "npm run payload -- migrate:fresh",
    "payload:generate:importmap": "npm run payload -- generate:importmap",
    "payload:generate:types": "npm run payload -- generate:types",
    "ci": "npm run payload:migrate && npm run typecheck && npm run lint && npm run format:ci && npm test -- --run && npm run build",
    "ci:e2e": "npm run test:e2e",
    "update:dependencies": "npx --yes npm-check-updates --upgrade",
    "update:skills": "npx --yes skills update --project --yes"
  },
  "dependencies": {
    "@clerk/localizations": "4.7.0",
    "@clerk/nextjs": "7.4.2",
    "@payloadcms/db-postgres": "3.85.0",
    "@payloadcms/next": "3.85.0",
    "@payloadcms/richtext-lexical": "3.85.0",
    "@payloadcms/ui": "3.85.0",
    "graphql": "16.14.0",
    "next": "16.2.6",
    "payload": "3.85.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@clerk/testing": "2.0.34",
    "@dotenvx/dotenvx": "1.69.2",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "cross-env": "10.1.0",
    "eslint": "10.4.1",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "29.1.1",
    "nanoid": "5.1.11",
    "postcss": "8.5.15",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "qs-esm": "8.0.1",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "4.1.7"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
