# eslint-config-next 16 pulls in eslint-plugin-import 2.32.0, whose peer range
# tops out at ESLint 9. We're on ESLint 10, so plain `npm install` emits an
# ERESOLVE warning. npm 7+ overrides peers by default, so the install proceeds,
# but pnpm and `npm install --strict-peer-deps` would hard-fail without this.
# Drop this line once eslint-plugin-import widens its peer range.
legacy-peer-deps=true
