# Clerk: API keys - https://dashboard.clerk.com/~/api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk: custom in-app sign-in / sign-up routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/registration
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Clerk: webhook signing secret - Clerk dashboard → Webhooks → Endpoints
CLERK_WEBHOOK_SIGNING_SECRET=

# Payload
PAYLOAD_SECRET=
DATABASE_URL=file:./payload-clerk-example.db
