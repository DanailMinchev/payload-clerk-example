### Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/registration
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

### Postgres
# Local Docker Compose uses these defaults. In production, set DATABASE_URL to your managed Postgres connection string, or provide equivalent POSTGRES_* values only if your deployment environment expands DATABASE_URL from them.
POSTGRES_DB=payload_clerk_example
POSTGRES_USER=payload
POSTGRES_PASSWORD=payload
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

### Payload
# Payload reads DATABASE_URL. The value below is convenient for local .env files because Next.js and dotenvx expand $POSTGRES_* references before the app/CLI read process.env.DATABASE_URL.
DATABASE_URL=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB
PAYLOAD_SECRET=

